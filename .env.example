# WordPress REST API Base URL
VITE_WP_API_BASE=https://www.cocheras.com.ar/wp-json

# Facultativo: Credenciales si el CPT o los campos requieren autenticación
WP_APP_USER=
WP_APP_PASSWORD=

# Chat de Cliengo. Por defecto usa la cuenta que ya tiene el WordPress actual
# (no hace falta configurar nada). Para cambiar de cuenta, pegar acá la URL del
# `ldk.src` del panel de Cliengo. Para apagarlo: VITE_CLIENGO_SCRIPT=off
VITE_CLIENGO_SCRIPT=
